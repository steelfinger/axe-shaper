{
 "source": {
  "plan": "Gibson ES-335 style plan (webp raster, about 1140 x 896 px, scale length 628.7 mm); supplied by the project owner.",
  "method": "The plan is a raster, so this is a pixel trace, not a vector read: about 1 mm per pixel. Scale and nut position come from a least-squares fit of the plan's 12 fret lines against equal-temperament positions (0.976 px/mm, residuals under 1.2 px). The neck-junction line was measured where the body edges meet the fingerboard (x=507 px, 419.6 mm from the nut, against fret 19 at 418.9 mm). The body is symmetric, so only the bass half was traced and mirrored; a leader line polluted the treble cutaway. Outer silhouette of all body lines, closed across the neck gap, eroded 2 px to the line centre, smoothed and fitted with cubic Beziers (0.4 mm). Plan x/y rotated into app coordinates: X = (planY - 325.7px)/0.976 with treble +, Y = (507.4px - planX)/0.976.",
  "accuracy": "Plus or minus about 1.5 mm on the outline and 1 mm on hardware. Treat as a first draft to refine by hand."
 },
 "measured": {
  "pxPerMm": 0.976,
  "nutToBodyEdgeMm": 418.8632,
  "nutToBodyEdgeNote": "Fret 19, as the owner specified; the plan agrees to within 1 px.",
  "fingerboardOverhangMm": 33.3778,
  "tomPostLineYMm": 209.9,
  "stopbarYMm": 248.4,
  "bodyThicknessMm": 38.1,
  "bodyThicknessNote": "An assumption, not read from the plan: about 44.5 mm at the rim overall for a 335, the arched cap being the rest. For carved_cap the field means the core below the rim.",
  "fHoleDepthMm": 20,
  "fHoleNote": "Nominal 2 cm cavity per the owner, to give the impression of a cut top plate; real F-holes go through the top plate only."
 },
