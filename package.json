{
  "name": "axe-shaper-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-viewer": "node scripts/dev-with-viewer3d.ts",
    "build": "npm run bridge:check && tsc -b && vite build",
    "viewer3d:fetch": "node scripts/fetch-viewer3d.ts",
    "build:site": "npm run build && npm run viewer3d:fetch",
    "deploy": "npm run build:site && firebase deploy --only hosting",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "corpus": "node scripts/generate-golden-corpus.ts",
    "corpus:check": "node scripts/generate-golden-corpus.ts --check",
    "bridge:check": "node scripts/check-bridge-drawing.ts",
    "dxf:check": "node scripts/check-dxf-export.ts",
    "marketing:plan": "node scripts/build-marketing-plan.ts",
    "fixtures:check": "node scripts/write-web-v8-fixture.ts --check && node scripts/check-ios-fixtures.ts",
    "schema:check": "node scripts/check-schema-migration.ts",
    "bass:check": "node scripts/check-bass-hardware.ts",
    "check:all": "node scripts/check-all.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "konva": "^10.3.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dxf-parser": "^1.1.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
