      "canonicalJson": "{\"é\":\"decomposed\",\"é\":\"composed\",\"😀\":\"astral\",\"\":\"bmp\"}",
      "expectedDigest": "sha256:39523ad87a2ed4f2e31af86f760d90aea85ca40ec7434176af240151a92d0ed2"
    },
    {
      "id": "nested-array-order",
      "inputJson": "{\"z\":[{\"b\":2,\"a\":1},3,2,1],\"a\":null}",
