# Parameters for the sharingApi Function on the staging project only. Loaded by
# the Firebase CLI because the file name matches the project ID. Production has
# no .env file and no deployment of this codebase yet.
SHARING_RELEASE_TAG=v1.3.2-web.1
# Release policy admits all fields authored by the deployed editor.
SHARING_MAX_ACCEPTED_SCHEMA=9
# Comma-separated Hosting domains that may front the API (X-Forwarded-Host).
SHARING_HOSTING_SITES=axe-shaper-staging.web.app,axe-shaper-staging.firebaseapp.com
# Absolute origin used in canonical and social-card URLs on /share/:id pages.
SHARING_PUBLIC_ORIGIN=https://axe-shaper-staging.web.app
